rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        && incoming().displayName is string
        && incoming().displayName.size() <= 100;
      allow delete: if isOwner(userId);

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(categoryId)
          && incoming().userId == userId
          && incoming().name is string
          && incoming().name.size() <= 100;
        allow delete: if isOwner(userId);
      }

      // Questions subcollection
      match /questions/{questionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(questionId)
          && incoming().userId == userId
          && incoming().question is string
          && incoming().question.size() <= 2000;
        allow delete: if isOwner(userId);
      }

      // Quiz History subcollection
      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(historyId)
          && incoming().userId == userId
          && incoming().score is number;
        allow delete: if isOwner(userId);
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
